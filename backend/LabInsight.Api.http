Accept: application/json

###

GET {{LabInsight.Api_HostAddress}}/api/getAnalysisCategories?isDeleted=false
Accept: application/json

###

GET {{LabInsight.Api_HostAddress}}/api/getGraphTypes?isDeleted=false
Accept: application/json

###

GET {{LabInsight.Api_HostAddress}}/api/getGraphDataTypes?isDeleted=false
Accept: application/json

###

